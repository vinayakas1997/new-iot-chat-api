# Hindsight needs an LLM key for memory ops (retain/recall/reflect).
# Health + Control Plane UI work without it. Either a real provider key…
HINDSIGHT_API_LLM_API_KEY=
# …or point it at your local OpenAI-compatible LLM (see F6):
# HINDSIGHT_API_LLM_PROVIDER=openai
# HINDSIGHT_API_LLM_BASE_URL=http://host.docker.internal:11434/v1
# HINDSIGHT_API_LLM_MODEL=qwen3:8b
