# Hindsight LLM wiring. Edit, then `docker compose up -d` in this folder.
# Option A — hosted provider key:
HINDSIGHT_API_LLM_API_KEY=
# Option B — local OpenAI-compatible LLM (e.g. the atlas-35b box):
# HINDSIGHT_API_LLM_API_KEY=local-dummy-key
# HINDSIGHT_API_LLM_PROVIDER=openai
# HINDSIGHT_API_LLM_BASE_URL=http://host.docker.internal:8009/v1
# HINDSIGHT_API_LLM_MODEL=qwen36-35B
