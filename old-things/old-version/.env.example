# ------------------------------------------------------------------
# Copy to .env and fill in. With RUNTIME_MODE=mock the system boots
# with zero external services (mock LLM, sample machine data, fake
# Hindsight). Set RUNTIME_MODE=live and fill the rest to go real.
# ------------------------------------------------------------------

RUNTIME_MODE=mock            # mock | live
NODE_ENV=development
LOG_LEVEL=info

# --- Backend API ---
API_PORT=3001
API_CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# --- Industrial Postgres (read-only role in live mode) ---
# Ignored when RUNTIME_MODE=mock.
MACHINE_DATABASE_URL=postgres://ro_user:changeme@localhost:5432/plant
MACHINE_DB_POOL_MAX=5
MACHINE_DB_STATEMENT_TIMEOUT_MS=8000
MACHINE_DB_CONNECT_TIMEOUT_MS=5000

# --- App store (ours) — always required ---
# In mock mode you may point this at a local docker Postgres (see docker-compose.yml).
APP_DATABASE_URL=postgres://app:app@localhost:5433/app
APP_DB_POOL_MAX=10

# --- Hindsight (memory store) ---
# Ignored when RUNTIME_MODE=mock.
HINDSIGHT_API_URL=http://localhost:8888
HINDSIGHT_LLM_API_KEY=                 # Hindsight server-side fact-extraction / entity-resolution key
HINDSIGHT_BANK_SCHEME=per-line         # per-line | per-machine | per-plant

# --- Chat LLM ---
# Ignored when RUNTIME_MODE=mock.
ANTHROPIC_API_KEY=
CHAT_MODEL=claude-sonnet-5

# --- Auth (user UI) ---
AUTH_JWT_SECRET=dev-only-change-me-32-chars-minimum
AUTH_COOKIE_NAME=irs_session
AUTH_SESSION_TTL_DAYS=7

# --- Auth (ops UI) — separate credential ---
OPS_USERNAME=builder
OPS_PASSWORD_HASH=                     # argon2 hash of the ops password; empty => ops UI disabled
OPS_COOKIE_NAME=irs_ops_session

# --- Report delivery (optional; in-app history is always on) ---
SMTP_URL=
REPORT_WEBHOOK_URL=
